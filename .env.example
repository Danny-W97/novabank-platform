# Aktywacja profilu odbywa sie poza YAML, np. w PowerShell:
# $env:SPRING_PROFILES_ACTIVE="dev"
# Dla testow: $env:SPRING_PROFILES_ACTIVE="test"
# Do automatycznego wygenerowania klucza dev i restartu obu aplikacji uzyj:
# .\scripts\start-dev.ps1
# Do zatrzymania obu aplikacji bez zatrzymywania baz uzyj:
# .\scripts\stop-dev.ps1
# Dla uruchamiania banku i sklepu z IntelliJ przygotuj plik:
# .\scripts\generate-dev-env.ps1
# IntelliJ powinien wskazywac .novabank/env/dev.env w obu konfiguracjach.
# Profil prod wymaga osobnych sekretow i HTTPS. Nie uzywaj tego pliku jako magazynu
# sekretow produkcyjnych. W produkcji wstrzyknij zmienne z Vault, Kubernetes Secret
# albo innego menedzera sekretow.

POSTGRES_DB=bankdb
POSTGRES_USER=bankuser
POSTGRES_PASSWORD=change-me-before-first-start
POSTGRES_HOST=localhost
POSTGRES_PORT=5300

SHOP_POSTGRES_DB=shopdb
SHOP_POSTGRES_USER=shopuser
SHOP_POSTGRES_PASSWORD=change-me-before-first-start
SHOP_POSTGRES_HOST=localhost
SHOP_POSTGRES_PORT=5400

BANK_API_KEY=replace-with-a-long-random-secret
BANK_API_KEY_ID=legacy
# Stable identity, not a key ID. Configure explicitly; never infer historical owners.
SHOP_MERCHANT_ID=
# Comma-separated key-id=merchant-id pairs, including both keys during rotation.
BANK_API_KEY_MERCHANTS=
# Comma-separated merchant-id=account pairs; join multiple accounts of one merchant with +.
BANK_PAYMENT_MERCHANTS=
# Rotacja: id|secret|scope1,scope2|expiresAt;id-next|secret-next|scope1,scope2|expiresAt
# Sklep potrzebuje zakresów payments:write,payments:authorize,payments:status,payments:refund,payments:card
# Format: id|secret|payments:write,payments:authorize,payments:status,payments:refund,payments:card|expiresAt;...
BANK_API_KEYS=
BANK_API_RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_IP_PER_WINDOW=20
LOGIN_RATE_LIMIT_ACCOUNT_PER_WINDOW=5
AUTH_ACTION_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_ACTION_RATE_LIMIT_IP_PER_WINDOW=10
TRANSFER_RATE_LIMIT_IP_PER_WINDOW=20
TRANSFER_RATE_LIMIT_USER_PER_WINDOW=10
SHOP_RATE_LIMIT_ENABLED=true
SHOP_RATE_LIMIT_WINDOW_SECONDS=60
SHOP_LOGIN_RATE_LIMIT_IP_PER_WINDOW=20
SHOP_LOGIN_RATE_LIMIT_ACCOUNT_PER_WINDOW=5
SHOP_CHECKOUT_RATE_LIMIT_IP_PER_WINDOW=30
SHOP_CHECKOUT_RATE_LIMIT_USER_PER_WINDOW=15
SHOP_PAYMENT_RATE_LIMIT_IP_PER_WINDOW=20
SHOP_PAYMENT_RATE_LIMIT_USER_PER_WINDOW=10
SHOP_WEBHOOK_RATE_LIMIT_IP_PER_WINDOW=60
TRANSFER_TOTP_REQUIRED_ABOVE=5000.00

# Lokalne porty monitoringu Actuator. Domyślnie dostępne tylko z tego komputera.
BANK_MANAGEMENT_PORT=8082
SHOP_MANAGEMENT_PORT=8083
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
# Konto techniczne Prometheusa. W prod wartości muszą pochodzić z Vault.
METRICS_USERNAME=metrics-reader
METRICS_PASSWORD=change-me-before-monitoring-start

# Retencja danych technicznych. W dev pozostaw dry-run=true.
RETENTION_ENABLED=false
RETENTION_DRY_RUN=true
RETENTION_SCHEDULE=0 0 3 * * *
RETENTION_BATCH_SIZE=500
RETENTION_GRACE_PERIOD_DAYS=7
RETENTION_LOGIN_HISTORY_DAYS=30
RETENTION_NOTIFICATION_DAYS=30
RETENTION_OPERATION_AUDIT_DAYS=90
RETENTION_ADMIN_AUDIT_DAYS=365
RETENTION_RUN_DAYS=365
BANK_API_URL=http://localhost:8080
# 32-bajtowy klucz Base64 do szyfrowania sekretow TOTP uzywanych przez 2FA.
TOTP_ENCRYPTION_KEY=generate-a-32-byte-base64-key
# Adres, na ktory bank wraca po potwierdzeniu platnosci w banku.
SHOP_PAYMENT_CALLBACK_URL=http://localhost:8081/payment/callback

# 26-cyfrowy numer rachunku sklepu utworzonego w aplikacji bankowej.
# Na ten rachunek trafiaja platnosci za zamowienia.
SHOP_MERCHANT_ACCOUNT_NUMBER=

# Automatyczne uzgadnianie statusu autoryzacji sklepu z bankiem.
SHOP_PAYMENT_RECONCILIATION_ENABLED=true
SHOP_PAYMENT_RECONCILIATION_INTERVAL_MS=30000
SHOP_PAYMENT_RECONCILIATION_INITIAL_DELAY_MS=10000
SHOP_PAYMENT_RECONCILIATION_BATCH_SIZE=50

# Card payment operator. Keep bank-demo for local legacy testing; use stripe for hosted checkout.
SHOP_PAYMENT_PROVIDER=bank-demo
SHOP_PAYMENT_API_BASE_URL=https://api.stripe.com
SHOP_PAYMENT_API_KEY=
SHOP_PAYMENT_WEBHOOK_SECRET=
SHOP_PAYMENT_SUCCESS_URL=http://localhost:8081/api/payments/stripe/success?order={ORDER_NUMBER}&session_id={CHECKOUT_SESSION_ID}
SHOP_PAYMENT_CANCEL_URL=http://localhost:8081/api/payments/stripe/cancel?order={ORDER_NUMBER}

REDIS_HOST=localhost
REDIS_PORT=6379

# Saldo demonstracyjne nowego rachunku
INITIAL_BALANCE=10000.00

# Opcjonalnie: po restarcie istniejące konto z tym e-mailem otrzyma rolę ADMIN
ADMIN_EMAIL=

# Ustaw true wyłącznie przy uruchomieniu aplikacji przez HTTPS
SESSION_COOKIE_SECURE=false

# Przyklad ustawien TLS dla reverse proxy (tylko dokumentacyjnie; profil dev ich nie wymaga).
# TLS_TERMINATION=proxy
# SERVER_SSL_ENABLED=false

# W produkcji bank wymaga rotowanego formatu kluczy:
# BANK_API_KEYS=key-2026-01|secret|payments:write,payments:authorize,payments:status,payments:refund|2026-12-31T23:59:59Z

# Ścieżka do regulaminu pobieranego ze strony logowania
# Profil prod: zmienne bootstrapowe Vault dostarczane poza repozytorium.
# VAULT_ADDR=https://127.0.0.1:8200
# VAULT_ROLE=bank-prod albo shop-prod
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_SSL_TRUST_STORE=file:C:/sciezka/vault-truststore.p12
# VAULT_SSL_TRUST_STORE_PASSWORD=
# VAULT_SSL_TRUST_STORE_TYPE=PKCS12

# Profil prod z TLS terminowanym w Spring Boot.
# TLS_TERMINATION=app
# SERVER_SSL_ENABLED=true
# BANK_API_URL=https://localhost:8080
# SHOP_PAYMENT_CALLBACK_URL=https://localhost:8081/payment/callback
# SERVER_SSL_KEY_STORE=file:C:/sciezka/bank-server.p12 (Bank)
# SERVER_SSL_KEY_STORE=file:C:/sciezka/shop-server.p12 (Shop)
# SERVER_SSL_KEY_STORE_TYPE=PKCS12
# SERVER_SSL_KEY_ALIAS=bank-local albo shop-local

# Kontrola waznosci certyfikatow (wlaczaj w prod; w dev pozostaw false)
# CERTIFICATE_MONITOR_ENABLED=false
# CERTIFICATE_MONITOR_SCHEDULE=0 0 3 * * *
# VAULT_TLS_CERTIFICATE_PATH=file:C:/sciezka/vault.crt

TERMS_FILE=regulamin/regulamin_novabank.pdf

# Backupy PostgreSQL wykonywane w WSL, Linuksie lub macOS.
# Opcjonalnie ustaw absolutna sciezke poza repozytorium, np.:
# WSL: /mnt/e/Bank-demo-backups/postgres
# Linux: /srv/backups/Bank-demo/postgres
# macOS: /Volumes/Backup/Bank-demo/postgres
# BACKUP_DIR=
BACKUP_RETENTION_DAYS=30
# Usuwanie starych backupow jest domyslnie wylaczone. Do czyszczenia uzyj --prune.
BACKUP_DELETE_OLD=false
BANK_POSTGRES_CONTAINER=bank-postgres
SHOP_POSTGRES_CONTAINER=shop-postgres
