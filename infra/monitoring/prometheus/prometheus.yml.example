global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]

scrape_configs:
  - job_name: bank-demo
    metrics_path: /actuator/prometheus
    scheme: http
    basic_auth:
      username: metrics-reader
      password: CHANGE_ME
    static_configs:
      - targets: ["localhost:8082"]
        labels:
          service: bank
          environment: dev

  - job_name: shop-app
    metrics_path: /actuator/prometheus
    scheme: http
    basic_auth:
      username: metrics-reader
      password: CHANGE_ME
    static_configs:
      - targets: ["localhost:8083"]
        labels:
          service: shop
          environment: dev
